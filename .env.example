# Copie este arquivo para ".env" no seu ambiente local (o Railway usa as
# variáveis configuradas na aba "Variables" do serviço, não este arquivo).

# --- Obrigatórias ---
ADMIN_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# --- Cloudflare R2 (armazenamento de fotos e vídeos) ---
# Sem essas 5 variáveis preenchidas, o sistema continua funcionando do jeito
# antigo (fotos/vídeos guardados direto no banco). Preencha todas pra ativar
# o R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Opcionais ---
# PORT=3000                 # o Railway já define sozinho
# DATABASE_SSL=false        # só se precisar desligar o SSL do Postgres
